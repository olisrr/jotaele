# Jota Ele · configuración para SiteGround (Apache)

# HTTPS y dominio sin www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://jotaelerestaurante.com%{REQUEST_URI} [L,R=301]

# Redirecciones de las URL de la web antigua (WordPress)
RewriteRule ^tienda/?$ /regalo/ [L,R=301]
RewriteRule ^carrito/?$ /regalo/ [L,R=301]
RewriteRule ^finalizar-compra/?$ /regalo/ [L,R=301]
RewriteRule ^mi-cuenta/?$ / [L,R=301]
RewriteRule ^producto/experiencia-jota-ele-dos-personas/?$ /regalo/ [L,R=301]
RewriteRule ^categoria-producto/ /regalo/ [L,R=301]
RewriteRule ^sugerencias/sugerencias/?$ /carta/#sugerencias [L,R=301,NE]
RewriteRule ^sugerencias/(generosos|espumosos|blancos|tintos|dulces)/?$ /carta/#$1 [L,R=301,NE]
RewriteRule ^author/ / [L,R=301]
RewriteRule ^feed/?$ / [L,R=301]
RewriteRule ^menu/?$ /carta/ [L,R=301]
RewriteRule ^menu-navidad/?$ /navidad/ [L,R=301]
RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [L,R=301]

# Páginas sin barra final → con barra (carpetas con index.html)
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Tipos de archivo
AddType text/markdown .md
AddType text/plain .txt
AddType image/webp .webp
AddType font/woff2 .woff2
AddDefaultCharset utf-8

# Caché: imágenes, fuentes y CSS un año; HTML siempre fresco
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Propuestas internas: fuera de Google
  <If "%{REQUEST_URI} =~ m#^/(b|qr)/#">
    Header set X-Robots-Tag "noindex"
  </If>
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/markdown application/xml image/svg+xml application/ld+json
</IfModule>

# La página de recetas se quitó (los vídeos están en la carta)
RewriteRule ^recetas/?$ /carta/ [L,R=301]
